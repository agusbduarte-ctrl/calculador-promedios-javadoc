<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ejemplo.promedio.controller.PrimaryController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="titulo" text="Calculador de Promedios" />
    <TextField fx:id="txtNombre" promptText="Nombre del alumno" />
    <TextField fx:id="txtNota_1" promptText="Nota 1 (0 a 10)" />
    <TextField fx:id="txtNota2" promptText="Nota 2 (0 a 10)" />
    <TextField fx:id="txtNota3" promptText="Nota 3 (0 a 10)" />

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#calcular" text="Calcular Promedio" />
        <Button onAction="#limpiar" text="Limpiar" />
        <Button onAction="#limpiarHistorial" text="Limpiar Historial" />
    </HBox>

    <Label fx:id="lblResultado" styleClass="resultado" text="" />
    <Label styleClass="subtitulo" text="Historial:" />
    <ListView fx:id="listaHistorial" prefHeight="180.0" />
</VBox>
